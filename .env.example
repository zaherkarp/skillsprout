# Application
APP_NAME=SkillSprout
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
# Default: a local SQLite file — no Postgres needed. `make run` sets this for you.
DATABASE_URL=sqlite+aiosqlite:///./skillsprout.db
DATABASE_URL_SYNC=sqlite:///./skillsprout.db
# For the full stack (docker compose --profile full), use Postgres instead:
# DATABASE_URL=postgresql+asyncpg://skillsprout:skillsprout@localhost:5432/skillsprout
# DATABASE_URL_SYNC=postgresql+psycopg2://skillsprout:skillsprout@localhost:5432/skillsprout

# Redis + Celery — only needed for the full stack (background cache-warming /
# nightly retrain). The app itself runs without them.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# O*NET Web Services — OPTIONAL. Leave the credentials blank to run fully
# offline against the bundled O*NET 28.3 dataset (~1,000 occupations). Fill them
# in only to fetch live data from services.onetcenter.org.
ONET_USERNAME=
ONET_PASSWORD=
ONET_BASE_URL=https://services.onetcenter.org/ws
ONET_TIMEOUT=30
ONET_MAX_RETRIES=3

# Offline data source used whenever credentials are blank:
#   file -> bundled O*NET snapshot (default, full catalog)
#   mock -> small built-in fixture set
ONET_OFFLINE_SOURCE=file
ONET_OFFLINE_DATA_PATH=client/data/onet-full.json

# Demo Mode. Offline is already the default when credentials are blank; set this
# true to force offline even if credentials happen to be present.
DEMO_MODE=true

# Model Configuration
MODEL_VERSION=v1_baseline
MODEL_TRAINING_MIN_SAMPLES=50
EXPLORATION_EPSILON=0.1

# Scoring Thresholds
READY_NOW_MATCH_THRESHOLD=75
READY_NOW_GAP_THRESHOLD=25
TRAINABLE_MATCH_MIN=50
TRAINABLE_MATCH_MAX=74
TRAINABLE_GAP_MIN=26
TRAINABLE_GAP_MAX=55

# Background Tasks
CACHE_WARM_BATCH_SIZE=50
PERIODIC_TRAINING_CRON="0 2 * * *"  # 2 AM daily

# Authentication
AUTH_ENABLED=false                # Set to true in production (requires API_KEY)
API_KEY=                          # Set a strong API key when AUTH_ENABLED=true

# Feature Flags
ENABLE_PRIVATE_MODE=true          # Allow X-Private-Mode header for zero-logging sessions
ENABLE_BIAS_MITIGATIONS=true      # Enable bias mitigation strategies (staleness penalty, skill reweighting)
ENABLE_LITE_MODE=true             # Allow ?lite=true for bandwidth-optimized responses
ENABLE_SESSION_EXPORT=true        # Allow session token export/import for device continuity

# Cold Start Configuration
COLD_START_CLUSTER_K=50           # Number of occupation clusters for rare-occupation cold start
COLD_START_MIN_INTERACTIONS=30    # Minimum interactions before using occupation-specific calibration
COLD_START_USER_PRIOR_WEIGHT=0.3  # Maximum prior weight for new users (fades with interaction count)

# Privacy & Retention
DATA_RETENTION_DAYS=90            # Days before event-level tracking data is purged
DELETION_COMPLIANCE_HOURS=72      # Hours to complete full user data deletion
SESSION_TOKEN_EXPIRY_DAYS=30      # Expiry for exported session tokens

# Monitoring
METRICS_ENABLED=true              # Expose /metrics endpoint for Prometheus
HEALTH_CHECK_TIMEOUT_MS=500       # Max latency for individual health check components
SCORING_LATENCY_WARN_MS=2000      # Log warning if scoring takes longer than this
